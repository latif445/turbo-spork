------MultipartBoundary--5lDyHDwsRdIvQzUlN4Rw7wgniEH8QbwRPgh0whjeHq----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-6d26b89a-b1c6-4800-8447-a7c9ffc678b4@mhtml.blink

@charset "utf-8";

*, ::before, ::after { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { font-family: Inter, sans-serif; background: rgb(248, 251, 252); color: rgb(26, 26, 46); overflow-x: hidden; }

::-webkit-scrollbar { width: 8px; }

::-webkit-scrollbar-track { background: rgb(241, 245, 249); }

::-webkit-scrollbar-thumb { background: rgb(0, 180, 224); border-radius: 4px; }

.hero-bg { background-image: url("https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=1400&q=80"); background-size: cover; background-position: center center; }

.hero-overlay { background: linear-gradient(135deg, rgba(0, 50, 80, 0.55) 0%, rgba(0, 100, 130, 0.35) 50%, rgba(0, 180, 224, 0.15) 100%); }

@keyframes float { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-12px); }
}

.float-anim { animation: 4s ease-in-out 0s infinite normal none running float; }

.float-anim-delay { animation: 4s ease-in-out 1.5s infinite normal none running float; }

@keyframes fadeInUp { 
  0% { opacity: 0; transform: translateY(40px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.fade-in-up { opacity: 0; animation: 0.8s ease 0s 1 normal forwards running fadeInUp; }

.fade-in-up-delay-1 { opacity: 0; animation: 0.8s ease 0.15s 1 normal forwards running fadeInUp; }

.fade-in-up-delay-2 { opacity: 0; animation: 0.8s ease 0.3s 1 normal forwards running fadeInUp; }

.fade-in-up-delay-3 { opacity: 0; animation: 0.8s ease 0.45s 1 normal forwards running fadeInUp; }

